# Beispiel-Konfiguration fuer infra/docker-compose.yml
# Kopiere diese Datei zu .env und passe die Werte an.
# Story-Bezug: PQC-17 (INF-3).
#
# Sprint 1: Minimaler Satz, wird in spaeteren Sprints (SKL-1, AUT-*, TLS-Stories) erweitert.

# Host-Port auf den nginx Port 80 gemappt wird. Aenderbar, falls 8080 belegt ist.
NGINX_HTTP_PORT=8080

# Host-Port auf den nginx Port 443 (TLS mit X25519MLKEM768) gemappt wird.
# PQC-18 INF-4. Verwendung: openssl s_client -connect localhost:8443 -groups X25519MLKEM768
NGINX_HTTPS_PORT=8443

# Reserviert fuer SKL-1 (PQC-19) und AUT-* Stories:
# AUTH_SERVICE_LOG_LEVEL=info
# AUTH_SERVICE_SECRET_KEY=change-me-before-running-in-anything-other-than-localhost

# ---------------------------------------------------------------------------
# OAuth Provider Credentials (Story PQC-84 BRK-0)
# ---------------------------------------------------------------------------
# Echte Werte gehoeren in `.env` (gitignored), nicht in diese Datei.
# Setup-Anleitung: server/README.md Abschnitt "OAuth Provider Setup".
#
# Google OAuth: erstellt via Google Cloud Console -> APIs & Services
# -> Credentials -> OAuth 2.0 Client ID (Web application).
# Authorized redirect URIs muss eingetragen sein:
#   - http://localhost:8080/auth/oauth/google/callback (Dev)
#   - Production: https://<dein-domain>/auth/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=replace-me-with-id-from-google-cloud-console.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=replace-me-with-GOCSPX-secret

# Microsoft OAuth: erstellt via Azure AD / Microsoft Entra ID
# -> App registrations -> New registration (Web).
# Single-Tenant fuer Dev empfohlen. Multi-Tenant erfordert komplexere
# iss-Claim-Verifikation im BRK-3 (PQC-38).
# Redirect-URI muss eingetragen sein:
#   - http://localhost:8080/auth/oauth/microsoft/callback (Dev)
#   - Production: https://<dein-domain>/auth/oauth/microsoft/callback
MICROSOFT_OAUTH_CLIENT_ID=replace-me-with-application-client-id-uuid
MICROSOFT_OAUTH_CLIENT_SECRET=replace-me-with-client-secret-value
MICROSOFT_OAUTH_TENANT_ID=replace-me-with-directory-tenant-id-uuid
