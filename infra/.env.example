# Beispiel-Konfiguration fuer infra/docker-compose.yml
# Kopiere diese Datei zu .env und passe die Werte an.
# Story-Bezug: PQC-17 (INF-3).
#
# Sprint 1: Minimaler Satz, wird in spaeteren Sprints (SKL-1, AUT-*, TLS-Stories) erweitert.

# Host-Port auf den nginx Port 80 gemappt wird. Aenderbar, falls 8080 belegt ist.
NGINX_HTTP_PORT=8080

# Host-Port auf den nginx Port 443 (TLS mit X25519MLKEM768) gemappt wird.
# PQC-18 INF-4. Verwendung: openssl s_client -connect localhost:8443 -groups X25519MLKEM768
NGINX_HTTPS_PORT=8443

# Reserviert fuer SKL-1 (PQC-19) und AUT-* Stories:
# AUTH_SERVICE_LOG_LEVEL=info
# AUTH_SERVICE_SECRET_KEY=change-me-before-running-in-anything-other-than-localhost
