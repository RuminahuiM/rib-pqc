# Build-Kontext schlank halten.
.venv
__pycache__
*.pyc
*.pyo
*.pyd
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
.coverage.*
htmlcov/
dist
build
*.egg-info

# Editor- und OS-Stuff
.idea
.vscode
*.swp
.DS_Store
Thumbs.db

# Env und lokale Secrets gehoeren nicht in den Build-Kontext.
.env
.env.*
!.env.example

# Tests bleiben im Build-Kontext, damit der Multi-Stage `test`-Target sie
# via COPY einschliessen kann (PQC-66/67 QUA-4/5). Der Prod-Stage `runtime`
# hat kein COPY tests -> tests landen nur im test-Image, nicht im Prod-Image.
